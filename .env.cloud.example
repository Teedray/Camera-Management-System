# Copy to .env.cloud and enter your bucket-scoped credentials locally.
# Use an existing private bucket. Keep r2.dev and custom public domains disabled.
CLOUD_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUD_BUCKET=YOUR_PRIVATE_BUCKET
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
